# /etc/kb-api.env — настройки kb-api. Права: chmod 600, владелец root.

# Данные GitHub App (Settings → Developer settings → GitHub Apps → ваше приложение)
GITHUB_CLIENT_ID=Iv23li...
GITHUB_CLIENT_SECRET=...

# Адрес сайта без слеша в конце — с него разрешены запросы и на него вернёт вход
SITE_ORIGIN=https://vlmb.ru

# Репозиторий заметок и ветка
REPO=VLmb/knowledge
BRANCH=main

# Кому можно редактировать (логины GitHub через запятую)
ALLOWED_USERS=VLmb

# Ключ шифрования сессий: openssl rand -hex 32
SESSION_SECRET=

# Необязательно
# PORT=8787
# SESSION_TTL_DAYS=365        # сколько живёт вход без захода на сайт (каждый заход продлевает)
# MAX_UPLOAD_MB=10

# ── Google Tasks (необязательно) ──
# OAuth-клиент «Web application» из Google Cloud Console, redirect URI:
#   https://ваш-домен/api/gtasks/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GTASKS_FOLDER=Задачи          # заметка «Задачи/Работа.md» = список «Работа»
# GTASKS_TAG=#задача            # чекбоксы с этим тегом в любых заметках
# GTASKS_DEFAULT_LIST=          # куда идут задачи с тегом (по умолчанию — первый список)
# GTASKS_INTERVAL_MIN=5
